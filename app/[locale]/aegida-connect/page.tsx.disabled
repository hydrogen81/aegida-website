import type { Metadata } from 'next'
import type { Locale } from '@/lib/i18n'
import AegidaConnectContent from '@/components/AegidaConnectContent'

export async function generateMetadata({
  params,
}: {
  params: { locale: string }
}): Promise<Metadata> {
  const locale = params.locale as Locale

  const titles: Record<string, string> = {
    it: 'AEGIDA Connect — Messaggistica Cifrata Gratuita per Linux',
    en: 'AEGIDA Connect — Free Encrypted Messaging for Linux',
    de: 'AEGIDA Connect — Kostenlose verschluesselte Kommunikation fuer Linux',
  }

  const descriptions: Record<string, string> = {
    it: 'App di messaggistica end-to-end cifrata gratuita per Linux desktop. Architettura P2P, nessun server centrale, crittografia Curve25519 e ChaCha20. Open source.',
    en: 'Free end-to-end encrypted messaging app for Linux desktop. P2P architecture, no central servers, Curve25519 and ChaCha20 cryptography. Open source.',
    de: 'Kostenlose Ende-zu-Ende verschluesselte Messaging-App fuer Linux Desktop. P2P-Architektur, keine zentralen Server, Curve25519- und ChaCha20-Kryptografie. Open Source.',
  }

  return {
    title: titles[locale] || titles.it,
    description: descriptions[locale] || descriptions.it,
    alternates: {
      languages: {
        'it': '/it/aegida-connect/',
        'en': '/en/aegida-connect/',
        'de': '/de/aegida-connect/',
      },
    },
  }
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'AEGIDA Connect',
  applicationCategory: 'CommunicationApplication',
  operatingSystem: 'Linux',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
  },
  brand: { '@type': 'Brand', name: 'AEGIDA' },
  publisher: { '@type': 'Organization', name: 'H4R Human for Research Srl' },
}

export default function AegidaConnectPage() {
  return (
    <>
      <script
        type="application/ld+json"
        dangerouslySetInnerHTML={{ __html: JSON.stringify(jsonLd) }}
      />
      <AegidaConnectContent />
    </>
  )
}
